#!/bin/sh
set -eu
umask 077

ARCHIVE_ROOT=${MIKA_ARCHIVE_ROOT:-/srv/mika-discord-archive}
ARCHIVE_COMMAND=${MIKA_ARCHIVE_COMMAND:-$ARCHIVE_ROOT/archive}
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
LOG="$ARCHIVE_ROOT/logs/weekly-$STAMP.log"

mkdir -p "$ARCHIVE_ROOT/logs"
{
    echo "weekly archive start: $STAMP"
    "$ARCHIVE_COMMAND" sync
    "$ARCHIVE_COMMAND" export
    "$ARCHIVE_COMMAND" verify --online
    "$ARCHIVE_COMMAND" status
    echo "weekly archive complete: $(date -u +%Y%m%dT%H%M%SZ)"
} >>"$LOG" 2>&1
